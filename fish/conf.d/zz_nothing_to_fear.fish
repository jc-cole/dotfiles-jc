# Nothing to fear: ink, paper, hot pink, violet, cyan, and signal red.
# Loaded after fish_frozen_theme.fish so this palette takes precedence.
set -g fish_color_normal e9eee9
set -g fish_color_command e9eee9 --bold
set -g fish_color_keyword ff38dc --bold
set -g fish_color_quote 9b87ff
set -g fish_color_redirection 36c9dc --bold
set -g fish_color_end ff38dc
set -g fish_color_error ff615b --bold
set -g fish_color_param c7d2d0
set -g fish_color_comment 85858f --italics
set -g fish_color_match ff38dc --bold
set -g fish_color_selection --background=403052
set -g fish_color_search_match e9eee9 --background=403052
set -g fish_color_operator 36c9dc
set -g fish_color_escape ff38dc
set -g fish_color_autosuggestion 777780
set -g fish_color_valid_path --underline
set -g fish_color_option 36c9dc
set -g fish_color_cwd 36c9dc
set -g fish_color_cwd_root ff615b
set -g fish_color_user e9eee9
set -g fish_color_host 9b87ff
set -g fish_color_host_remote ff38dc
set -g fish_color_status ff615b
set -g fish_color_cancel --reverse
set -g fish_color_history_current --bold
set -g fish_pager_color_progress 36c9dc --background=24212b
set -g fish_pager_color_background
set -g fish_pager_color_prefix ff38dc --bold
set -g fish_pager_color_completion e9eee9
set -g fish_pager_color_description 9b87ff
set -g fish_pager_color_selected_background --background=403052
set -g fish_pager_color_selected_prefix ff38dc --bold
set -g fish_pager_color_selected_completion e9eee9 --bold
set -g fish_pager_color_selected_description 36c9dc
set -g fish_pager_color_secondary_background
set -g fish_pager_color_secondary_prefix ff38dc
set -g fish_pager_color_secondary_completion c7d2d0
set -g fish_pager_color_secondary_description 85858f

set -g __fish_git_prompt_showdirtystate 1
set -g __fish_git_prompt_showuntrackedfiles 1
set -g __fish_git_prompt_showupstream auto
set -g __fish_git_prompt_char_stateseparator ' '
set -g __fish_git_prompt_char_dirtystate '*'
set -g __fish_git_prompt_char_stagedstate '+'
set -g __fish_git_prompt_char_untrackedfiles '?'
set -g __fish_git_prompt_char_stashstate '$'
set -g __fish_git_prompt_char_upstream_ahead '↑'
set -g __fish_git_prompt_char_upstream_behind '↓'
set -g __fish_git_prompt_color_branch 9b87ff
set -g __fish_git_prompt_color_dirtystate ff38dc
set -g __fish_git_prompt_color_stagedstate 36c9dc
set -g __fish_git_prompt_color_untrackedfiles 85858f
